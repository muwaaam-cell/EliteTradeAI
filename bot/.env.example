# Copy to .env locally. NEVER commit real values.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
CTRADER_ENV=demo
# Optional. If omitted, the runtime auto-selects only when exactly one demo
# account is returned by this OAuth authorization.
CTRADER_ACCOUNT_ID=

# Encrypted {ciphertext, iv} JSON copied from the Cloudflare D1 oauth_tokens row.
# This file contains ciphertext only, never plaintext tokens.
CTRADER_TOKEN_ENVELOPE_PATH=state/ctrader_tokens.worker.json
# Must be the same base64-encoded 32-byte AES key used by the Cloudflare Worker.
TOKEN_ENCRYPTION_KEY=

# Market observation defaults. Exact symbol names must exist in the broker catalogue.
CTRADER_MARKET_SYMBOLS=XAUUSD,EURUSD
CTRADER_TIMEFRAME=M15
CTRADER_HISTORY_DAYS=30
CTRADER_HISTORY_COUNT=500
CTRADER_MARKET_MEMORY=state/market_memory.sqlite3
# Level II depth feed enabled by default (higher mobile-data use; user approved).
CTRADER_ENABLE_DEPTH=1

# Per-instrument SCALPING candidate gates. Leave blank until calibrated from
# Pepperstone demo observations; blank values intentionally keep candidates WAIT.
# STOP_ATR_MULTIPLE and TARGET_ATR_MULTIPLE are ATR multipliers (positive decimals).
# MAX_SPREAD_PRICE and ADVERSE_PRICE_ALLOWANCE are positive price-unit values
# for the instrument; do not copy values between symbols or guess defaults.
CTRADER_XAUUSD_STOP_ATR_MULTIPLE=
CTRADER_XAUUSD_TARGET_ATR_MULTIPLE=
CTRADER_XAUUSD_MAX_SPREAD_PRICE=
CTRADER_XAUUSD_ADVERSE_PRICE_ALLOWANCE=
CTRADER_EURUSD_STOP_ATR_MULTIPLE=
CTRADER_EURUSD_TARGET_ATR_MULTIPLE=
CTRADER_EURUSD_MAX_SPREAD_PRICE=
CTRADER_EURUSD_ADVERSE_PRICE_ALLOWANCE=

# Safety defaults: analysis-only. Do not change.
LIVE_TRADING_ENABLED=false
SPOTWARE_APPROVED=false

# Risk limits are percentages of account equity.
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_OPEN_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=3

# Optional Telegram controls. Restrict to your numeric private chat ID.
# Keep bot token private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Copy to .env locally. NEVER commit real values.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=
CTRADER_ENV=demo

# Safety defaults: analysis-only. Do not change until all checks are complete.
LIVE_TRADING_ENABLED=false
SPOTWARE_APPROVED=false

# Risk limits are percentages of account equity.
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_OPEN_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=3

# Optional Telegram notifications. Keep token private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
